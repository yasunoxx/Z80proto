;	z80sioctc.def

	DEFC	CTC_Ch0 = 20h
	DEFC	CTC_Ch1 = 21h
	DEFC	CTC_Ch2 = 22h
	DEFC	CTC_Ch3 = 23h
	DEFC	SIO_Ch0_D = 24h
	DEFC	SIO_Ch0_C = 25h
	DEFC	SIO_Ch1_D = 26h
	DEFC	SIO_Ch1_C = 27h
;
	; SIO clock: 9600bps nearly = 13/2000000
	; (13 counts, SIO prescale is 16, (13*16)/2000000 = 9615.38bps)
	DEFC	CTC_SIO0_PRESC = 13
	DEFC	CTC_SIO1_PRESC = 13
;
; SCI Control Characters
	DEFC	NULL = 0
	DEFC	BELL = 07h
	DEFC	CR = 0Dh
	DEFC	LF = 0Ah
	DEFC	DELETE = 7Fh
	DEFC	BACKSPACE = 08h
	DEFC	DC1 = 11h
	DEFC	DC3 = 13h
	DEFC	XON = 11h
	DEFC	XOFF = 13h

; Control bits to host DTE
	DEFC	BIT_DTR = 7
	DEFC	BIT_RTS = 1

; switch flow control(EXPERIMENTAL)
	DEFC	NONE = 0
	DEFC	SOFT = 1
	DEFC	HARD = 2
	DEFC	SIO0_FLOW_CONTROL = NONE

; Flags F_STAT_SIOn
	DEFC	F_STAT_ALLSENT = 0
	DEFC	F_STAT_BREAK   = 1
	DEFC	F_STAT_RECEIVE = 2
	DEFC	F_STAT_TXEMPTY = 3
;
;;	external address
;	extern	INTSIO
;	extern	INTCTC
	extern	putAreg2chrs
